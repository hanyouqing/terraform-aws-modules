# Terraform Configuration File (example)
# Copy to ~/.terraformrc or: export TF_CLI_CONFIG_FILE="$(pwd)/.terraformrc"
#
# See committed .terraformrc for the recommended defaults.

provider_installation {
  direct {}
}

# Use ~ (Terraform expands it). Do not use $HOME — it is not expanded.
plugin_cache_dir = "~/.terraform.d/plugin-cache"
