# Minimal Organizations example — authenticate via AWS SSO / env; no keys in tfvars.
# Copy to terraform.tfvars and replace placeholders.

project     = "ihomelabs"
environment = "development"
region      = "us-east-1"

accounts = []

organizational_units = [
  {
    name = "Sandbox"
    tags = {
      Purpose = "Non-production experimentation"
    }
  }
]

service_control_policies = []

tags = {
  Owner = "platform"
}
