#!/bin/bash
# Terraform Environment Variables Configuration
# Copy to .env.sh, edit values, then: source .env.sh
# .env.sh is gitignored — never commit real credentials.

# ==============================================================================
# AWS Configuration
# ==============================================================================

export AWS_DEFAULT_REGION="us-east-1"
export AWS_REGION="${AWS_DEFAULT_REGION}"

# Preferred: AWS SSO profile
# export AWS_PROFILE="your-sso-profile"
# aws sso login --profile "$AWS_PROFILE"

# Optional static keys (avoid in production; prefer SSO / roles)
# export AWS_ACCESS_KEY_ID="your-access-key-id"
# export AWS_SECRET_ACCESS_KEY="your-secret-access-key"
# export AWS_SESSION_TOKEN=""

# export AWS_ACCOUNT_ID="123456789012"

# ==============================================================================
# Terraform Core
# ==============================================================================

export TF_DATA_DIR=".terraform"
# export TF_LOG="INFO"
# export TF_LOG_PATH="$HOME/.terraform.d/terraform.log"
export TF_PLUGIN_CACHE_DIR="$HOME/.terraform.d/plugin-cache"
export TF_INPUT="false"
export TF_PARALLELISM="10"

# ==============================================================================
# Remote State (Terragrunt / S3 backend)
# ==============================================================================

# Created by the tfstate module — wire into terragrunt/personal/account.hcl
# export TF_BACKEND_BUCKET="ihomelabs-terraform-state-development"
# export TF_BACKEND_DYNAMODB_TABLE="ihomelabs-terraform-state-lock-development"

# ==============================================================================
# Module Inputs (TF_VAR_*)
# ==============================================================================

# export TF_VAR_region="${AWS_DEFAULT_REGION}"
# export TF_VAR_project="ihomelabs"
# export TF_VAR_environment="development"  # development|testing|staging|production
# export TF_VAR_code="terraform-aws-modules:vpc"
# export TF_VAR_owner="platform"
# export TF_VAR_cost_center=""

# Cross-account assume role (caller / Terragrunt; not module credential vars)
# export TF_VAR_assume_role_arn="arn:aws:iam::123456789012:role/TerraformRole"
# export TF_VAR_assume_role_external_id=""
# export TF_VAR_assume_role_session_name="terraform"

# ==============================================================================
# Helpers
# ==============================================================================

tf_workspace() {
  local workspace="${1:-development}"
  terraform workspace select "$workspace" || terraform workspace new "$workspace"
  export TF_WORKSPACE="$workspace"
  echo "Switched to workspace: $workspace"
}

tf_show_config() {
  echo "=== Terraform / AWS Configuration ==="
  echo "AWS Region:  ${AWS_DEFAULT_REGION}"
  echo "AWS Profile: ${AWS_PROFILE:-not set}"
  echo "TF Workspace:${TF_WORKSPACE:-default}"
  echo "State Bucket:${TF_BACKEND_BUCKET:-not set}"
  echo "Lock Table:  ${TF_BACKEND_DYNAMODB_TABLE:-not set}"
  echo "====================================="
}

validate_aws_credentials() {
  if ! command -v aws >/dev/null 2>&1; then
    echo "aws CLI not found"
    return 1
  fi
  aws sts get-caller-identity
}
