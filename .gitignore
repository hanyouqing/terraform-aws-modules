# Local .terraform directories
.terraform/
**/.terragrunt-cache/

# Terraform lock files (generated locally; CI uses fresh init)
.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (may contain secrets). Keep *.tfvars.example.
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

.terraform.tfstate.lock.info

# Plan dumps (may contain sensitive values)
**/terraform-plan-output.md
*tfplan*
*.tfplan


# Private keys
*.pem

# CLI configuration (keep .terraformrc.example; committed .terraformrc is the shared template)
.terraformrc.local
terraform.rc

# Environment variables
.env.sh
.env.sh.local
*.env
!.env.sh.example

# OS / editor
.DS_Store
*.swp
*~
